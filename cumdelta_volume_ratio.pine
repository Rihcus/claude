//@version=6
// ─────────────────────────────────────────────────────────────────────────────
//  Cumulative Delta / Volume Ratio  —  intrabar resolution ladder
//
//  Delta is reconstructed from INTRABARS pulled with request.security_lower_tf().
//  The finer the intrabar, the less the classification is distorted, so the
//  script walks this ladder in order and takes the FIRST (finest) step that
//  still fits inside the intrabar budget:
//
//        1s  →  1m  →  5m  →  15m  →  1h  →  4h  →  1d
//
//  Each step is an exact multiple of the previous one, so intrabars tile the
//  parent bar without spillover. The chosen step, the intrabars-per-bar count
//  and whether the tiling is exact are all reported in the diagnostics table.
// ─────────────────────────────────────────────────────────────────────────────
indicator("Cumulative Delta / Volume Ratio (1s ladder)", "CVD/Vol", overlay = false, precision = 3)

// ── Inputs ───────────────────────────────────────────────────────────────────
string anchorIn = input.string("Week", "Reset cumulation on",
     options = ["Session (regular)", "Day", "Week", "Month", "Rolling window (bars)", "None (running)"], group = "Cumulation",
     tooltip = "A calendar anchor must be COARSER than the chart timeframe, and coarse enough that the period holds a useful number of bars. On a 4h chart Day gives only 6 bars, so prefer Week, Month, or the rolling window.")

int rollLen = input.int(42, "Rolling window length (bars)", minval = 2, maxval = 5000, group = "Cumulation",
     tooltip = "Used when anchor = Rolling window. No sawtooth at period boundaries and the denominator stays constant, so sensitivity does not decay.\n\nOn a 4h chart of CME futures (~6 bars/day, ~30/week, ~1510/year): 30 = a week, 126 = a month, 390 = a quarter, 1510 = a year. On a 24/7 instrument a week is 42.\n\nPlottable history = intrabar coverage minus this length, so a long window eats into how much clean output you can see.")

string methodIn = input.string("Tick rule (close vs prev close)", "Intrabar classification",
     options = ["Tick rule (close vs prev close)", "Candle polarity (close vs open)", "Proportional (close position in range)"],
     group = "Delta",
     tooltip = "Tick rule: sign of close-to-close change of each intrabar (falls back to polarity, then to range position, when flat).\nPolarity: close vs open of the intrabar.\nProportional: volume split by where the close sits inside the intrabar range.")

bool allowSec = input.bool(true, "Allow 1-second intrabars", group = "Resolution ladder",
     tooltip = "Requires a plan with 1s data. Turn off to start the ladder at 1m.")

int capIn = input.int(600, "Max intrabars per chart bar", minval = 4, maxval = 5000, step = 50,
     group = "Resolution ladder",
     tooltip = "The budget that decides how far up the ladder to climb. Higher = finer delta but less history, because request.security_lower_tf() returns at most ~100,000 intrabars in total (covered bars ≈ 100000 / intrabars-per-bar).")

int minBars = input.int(3, "Min bars before plotting", minval = 1, maxval = 500, group = "Sample-size guard",
     tooltip = "Right after an anchor reset the ratio is computed from one or two bars, so it swings to extremes — that is arithmetic, not order flow. The plot stays blank until this many CHART BARS have accumulated in the current period. Counted in bars, not intrabars, so the guard behaves the same on a fine rung as on a coarse one.")

bool hideDegraded = input.bool(true, "Blank out bars with no intrabar data", group = "Sample-size guard",
     tooltip = "Where the chosen rung has no history, a bar is signed as a single sample, which forces |delta| = volume and pins the ratio at ±1. Leave on to blank those bars and shade them instead of printing a fake extreme.")

bool resetOnSrc = input.bool(true, "Reset cumulation when the intrabar source changes", group = "Sample-size guard",
     tooltip = "A rung switch mid-period mixes two different delta magnitudes in one cumulative sum. Resetting at the boundary keeps each drawn segment internally consistent.")

int   smoothIn = input.int(0, "EMA smoothing (0 = off)", minval = 0, maxval = 200, group = "Display")
float thrIn    = input.float(0.25, "Imbalance threshold", minval = 0.0, maxval = 1.0, step = 0.05, group = "Display")
bool  showTbl  = input.bool(true, "Show diagnostics table", group = "Display")

// ── Ladder selection ─────────────────────────────────────────────────────────
// Walks 1s → 1m → 5m → 15m → 1h → 4h → 1d and returns the first step that is
// strictly below the chart timeframe AND fits the intrabar budget. If nothing
// fits the budget, returns the coarsest step still below the chart timeframe.
ladderPick(simple int cs, simple int cap, simple bool secOk) =>
    simple string tf = switch
        cs <= 1                                       => "1S"
        secOk and cs > 1     and cs         <= cap    => "1S"
        cs > 60              and cs / 60    <= cap    => "1"
        cs > 300             and cs / 300   <= cap    => "5"
        cs > 900             and cs / 900   <= cap    => "15"
        cs > 3600            and cs / 3600  <= cap    => "60"
        cs > 14400           and cs / 14400 <= cap    => "240"
        cs > 86400           and cs / 86400 <= cap    => "1D"
        // budget unreachable → coarsest rung below the chart timeframe
        cs > 86400 => "1D"
        cs > 14400 => "240"
        cs > 3600  => "60"
        cs > 900   => "15"
        cs > 300   => "5"
        cs > 60    => "1"
        => "1S"
    tf

// One rung coarser — used as a runtime fallback when the finer rung has no
// history for a given bar (typical for 1s data, which is only kept briefly).
ladderNext(simple string tf) =>
    simple string nx = switch tf
        "1S"  => "1"
        "1"   => "5"
        "5"   => "15"
        "15"  => "60"
        "60"  => "240"
        "240" => "1D"
        => "1D"
    nx

simple int    chartSec = timeframe.in_seconds(timeframe.period)
simple string ltf1     = ladderPick(chartSec, capIn, allowSec)
simple int    ltf1Sec  = timeframe.in_seconds(ltf1)
simple string ltf2Raw  = ladderNext(ltf1)
simple bool   useLtf2  = timeframe.in_seconds(ltf2Raw) < chartSec
simple string ltf2     = useLtf2 ? ltf2Raw : ltf1
simple bool   exactFit = ltf1Sec < chartSec and chartSec % ltf1Sec == 0

simple int methodCode = methodIn == "Candle polarity (close vs open)" ? 1 : methodIn == "Tick rule (close vs prev close)" ? 2 : 3

// ── Per-intrabar signed volume ───────────────────────────────────────────────
// Evaluated inside the lower-timeframe context, so close[1] is the previous
// INTRABAR close (correct across parent-bar boundaries).
signedVol(simple int m) =>
    float rng  = high - low
    float prop = rng > 0 ? 2.0 * (close - low) / rng - 1.0 : 0.0
    float pol  = close > open ? 1.0 : close < open ? -1.0 : 0.0
    float sgn  = switch m
        1 => pol
        2 => close > close[1] ? 1.0 : close < close[1] ? -1.0 : (pol != 0.0 ? pol : prop)
        => prop
    nz(volume) * sgn

[dA1, vA1] = request.security_lower_tf(syminfo.tickerid, ltf1, [signedVol(methodCode), nz(volume)], ignore_invalid_timeframe = true)
[dA2, vA2] = request.security_lower_tf(syminfo.tickerid, ltf2, [signedVol(methodCode), nz(volume)], ignore_invalid_timeframe = true)

// Last-resort fallback: the chart bar as a single sample. Deliberately ALWAYS
// proportional, never fully signed — signing one sample sets |delta| = volume,
// which pins the ratio at exactly ±1 and is what produced the spikes at the
// edge of intrabar history.
float cRng       = high - low
float chartDelta = cRng > 0 ? nz(volume) * (2.0 * (close - low) / cRng - 1.0) : 0.0

// ── Resolve this bar's delta from the best available source ──────────────────
float barDelta = 0.0
float barVol   = 0.0
int   nIntra   = 0
int   srcCode  = 0                                    // 1 = ladder rung, 2 = fallback rung, 3 = chart bar

if array.size(dA1) > 0
    barDelta := array.sum(dA1)
    barVol   := array.sum(vA1)
    nIntra   := array.size(dA1)
    srcCode  := 1
else if array.size(dA2) > 0
    barDelta := array.sum(dA2)
    barVol   := array.sum(vA2)
    nIntra   := array.size(dA2)
    srcCode  := 2
else
    barDelta := chartDelta
    barVol   := nz(volume)
    nIntra   := 1
    srcCode  := 3

// ── Cumulate and ratio ───────────────────────────────────────────────────────
bool reset = switch anchorIn
    "Session (regular)" => session.isfirstbar_regular
    "Day"               => timeframe.change("1D")
    "Week"              => timeframe.change("1W")
    "Month"             => timeframe.change("1M")
    => false

simple bool rolling  = anchorIn == "Rolling window (bars)"
simple int  anchorSec = anchorIn == "Week" ? 604800 : anchorIn == "Month" ? 2592000 : (anchorIn == "None (running)" or rolling) ? 0 : 86400
simple bool anchorTooFine = anchorSec > 0 and chartSec >= anchorSec

bool degraded = srcCode != 1
bool srcFlip  = not na(srcCode[1]) and srcCode != srcCode[1]

var float cumD = 0.0
var float cumV = 0.0
var int   cumN = 0                                    // intrabars accumulated in this period
var int   cumBars = 0                                 // chart bars accumulated in this period
if reset or (resetOnSrc and srcFlip)
    cumD := 0.0
    cumV := 0.0
    cumN := 0
    cumBars := 0
cumD += barDelta
cumV += barVol
cumN += nIntra
cumBars += 1

// Where does intrabar coverage actually start? History is contiguous from the
// right edge, so the first bar (chronologically) served by the chosen rung marks
// the boundary of the ~100k intrabar budget.
var int firstGoodTime = na
var int goodBars      = 0
if srcCode == 1
    goodBars += 1
    if na(firstGoodTime)
        firstGoodTime := time

// History is processed left to right, so the first srcCode 2 bar marks where the
// coarser fallback rung takes over from bar-level estimation.
var int firstFbTime = na
var int fbBars      = 0
if srcCode == 2
    fbBars += 1
    if na(firstFbTime)
        firstFbTime := time

// Rolling sums are stateful, so they run unconditionally even when unused.
float rollD = math.sum(barDelta, rollLen)
float rollV = math.sum(barVol, rollLen)
float rollN = math.sum(nIntra, rollLen)
float rollDeg  = math.sum(degraded ? 1.0 : 0.0, rollLen)
float rollFlip = math.sum(srcFlip ? 1.0 : 0.0, rollLen)

float useD = rolling ? rollD : cumD
float useV = rolling ? rollV : cumV
int   useN    = rolling ? (bar_index >= rollLen - 1 ? int(rollN) : 0) : cumN
int   useBars = rolling ? (bar_index >= rollLen - 1 ? rollLen : 0) : cumBars

float ratio = useV > 0.0 ? useD / useV : 0.0          // bounded in [-1, +1]

// Smooth the raw series, then mask: feeding na into ta.ema() poisons it for good.
float smoothed = smoothIn > 0 ? ta.ema(ratio, smoothIn) : ratio
bool  mixedWin = rolling and rollFlip > 0.0     // window spans a rung change
bool  dirty    = degraded or (rolling and rollDeg > 0.0) or mixedWin
bool  trusted  = useBars >= minBars and not (hideDegraded and dirty)
float plotted  = trusted ? smoothed : na

// How much continuously plottable history the current cap/window actually yields.
var int firstPlotTime = na
var int plotBars      = 0
if trusted
    plotBars += 1
    if na(firstPlotTime)
        firstPlotTime := time

// ── Plot ─────────────────────────────────────────────────────────────────────
color col = plotted >= 0 ? color.new(color.teal, 0) : color.new(color.red, 0)
p = plot(plotted, "CumDelta / Volume", color = col, linewidth = 2)
z = plot(0.0, "Zero", display = display.none)
fill(p, z, color = color.new(plotted >= 0 ? color.teal : color.red, 82))
hline(0.0, "Zero", color = color.new(color.gray, 40))
hline(thrIn,  "Bid/ask imbalance +", color = color.new(color.teal, 55), linestyle = hline.style_dotted)
hline(-thrIn, "Bid/ask imbalance −", color = color.new(color.red,  55), linestyle = hline.style_dotted)
// Amber = coarser fallback rung, deeper orange = bar-level estimate only.
// The two are not interchangeable: coarser samples cancel less, so |delta| per
// bar runs systematically higher and the ratio's amplitude is inflated.
bgcolor(srcCode == 2 ? color.new(color.yellow, 90) : srcCode == 3 ? color.new(color.orange, 84) : mixedWin ? color.new(color.purple, 88) : useBars < minBars ? color.new(color.gray, 92) : na,
     title = "Intrabar regime / warming up")
plot(nIntra, "Intrabars per bar", display = display.data_window)
plot(useN,   "Intrabars in window", display = display.data_window)
plot(useD,   "Delta (window)",  display = display.data_window)
plot(useV,   "Volume (window)", display = display.data_window)

// Alerts fire off the plotted (gated) series, so untrusted stretches stay silent.
alertcondition(ta.crossover(plotted, 0.0),    "CVD ratio crossed above 0", "Cumulative delta turned net positive")
alertcondition(ta.crossunder(plotted, 0.0),   "CVD ratio crossed below 0", "Cumulative delta turned net negative")
alertcondition(ta.crossover(plotted, thrIn),  "CVD ratio above threshold", "Buy-side imbalance")
alertcondition(ta.crossunder(plotted, -thrIn), "CVD ratio below threshold", "Sell-side imbalance")

// ── Diagnostics ──────────────────────────────────────────────────────────────
var table tbl = table.new(position.top_right, 2, 12, border_width = 1, frame_width = 1,
     frame_color = color.new(color.gray, 60), border_color = color.new(color.gray, 60))

// Compact number formatter for the table (1.23M, 456.7k, …).
compact(float x) =>
    float a = math.abs(x)
    string out = a >= 1e9 ? str.tostring(x / 1e9, "#.##") + "B" : a >= 1e6 ? str.tostring(x / 1e6, "#.##") + "M" : a >= 1e3 ? str.tostring(x / 1e3, "#.#") + "k" : str.tostring(x, "#.##")
    out

row(int r, string k, string v, color c) =>
    table.cell(tbl, 0, r, k, text_size = size.small, text_halign = text.align_left,
         text_color = color.new(color.gray, 10), bgcolor = color.new(color.gray, 92))
    table.cell(tbl, 1, r, v, text_size = size.small, text_halign = text.align_right,
         text_color = c, bgcolor = color.new(color.gray, 92))

if showTbl and barstate.islast
    string usedTf = srcCode == 1 ? ltf1 : srcCode == 2 ? ltf2 : timeframe.period
    string srcTxt = srcCode == 1 ? "ladder rung" : srcCode == 2 ? "fallback rung (finer data missing)" : "chart bar (no intrabars)"
    row(0, "Chart TF",        timeframe.period,                                     color.new(color.gray, 10))
    row(1, "Intrabar TF",     usedTf,                                               srcCode == 1 ? color.teal : color.orange)
    row(2, "Source",          srcTxt,                                               srcCode == 1 ? color.teal : color.orange)
    row(3, "Intrabars / bar", str.tostring(nIntra) + " (cap " + str.tostring(capIn) + ")", nIntra <= capIn ? color.new(color.gray, 10) : color.orange)
    row(4, "Tiling",          exactFit ? "exact" : ltf1Sec >= chartSec ? "n/a" : "inexact — boundary bias", exactFit ? color.teal : color.orange)
    row(5, "Anchor",          rolling ? "rolling " + str.tostring(rollLen) + " bars" : anchorIn + (anchorTooFine ? " — resets EVERY bar (use a coarser anchor)" : reset ? " (reset here)" : ""), anchorTooFine ? color.orange : color.new(color.gray, 10))
    row(6, "Intrabar data from", na(firstGoodTime) ? "none on this chart" : str.format_time(firstGoodTime, "yyyy-MM-dd", syminfo.timezone) + "  (" + str.tostring(goodBars) + " bars)", na(firstGoodTime) ? color.orange : color.new(color.gray, 10))
    row(7, "Fallback rung",   na(firstFbTime) ? "unused" : ltf2 + " from " + str.format_time(firstFbTime, "yyyy-MM-dd", syminfo.timezone) + "  (" + str.tostring(fbBars) + " bars)", na(firstFbTime) ? color.new(color.gray, 10) : color.orange)
    row(8, "Budget",          "~" + compact(100000.0 / math.max(nIntra, 1)) + " bars at " + str.tostring(nIntra) + " intrabars/bar", color.new(color.gray, 10))
    row(9, "Window",          str.tostring(useBars) + " bars / " + str.tostring(useN) + " intrabars" + (trusted ? "" : " — plot blank"), trusted ? color.new(color.gray, 10) : color.orange)
    row(10, "Plot starts",    na(firstPlotTime) ? "nothing plotted" : str.format_time(firstPlotTime, "yyyy-MM-dd", syminfo.timezone) + "  (" + str.tostring(plotBars) + " bars)", na(firstPlotTime) ? color.orange : color.teal)
    row(11, "Δ / Vol",         compact(useD) + " / " + compact(useV) + " = " + str.tostring(ratio, "#.###"), ratio >= 0 ? color.teal : color.red)
